{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Fióre boutique florist product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "shortDesc": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "stock": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isNew": { "type": "boolean" }
      },
      "required": ["id", "name", "categoryId", "price", "image", "description", "shortDesc", "rating", "reviewsCount", "stock", "isFeatured", "isNew"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "description", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "note": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerEmail", "recipientName", "recipientPhone", "shippingAddress", "totalAmount", "paymentMethod", "paymentStatus", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["id", "email", "name", "phone", "address", "isAdmin"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer contact form message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "replyDetail": { "type": "string" },
        "repliedAt": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "message", "createdAt", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount code / coupon",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string" },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "expiryDate": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code", "description", "discountType", "discountValue", "minOrderValue", "isActive"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and product rating review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "author": { "type": "string" },
        "email": { "type": "string" },
        "rating": { "type": "number" },
        "date": { "type": "string" },
        "comment": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "productName", "author", "email", "rating", "date", "comment", "likes", "createdAt"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter email subscriber",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "MarketingCampaign": {
      "title": "MarketingCampaign",
      "description": "Sent marketing holiday campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sentAt": { "type": "string" },
        "successCount": { "type": "number" },
        "errorCount": { "type": "number" },
        "year": { "type": "number" },
        "holidayCode": { "type": "string" }
      },
      "required": ["id", "sentAt", "successCount", "errorCount", "year", "holidayCode"]
    },
    "MarketingLog": {
      "title": "MarketingLog",
      "description": "Dispatch run details for a campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignName": { "type": "string" },
        "sentDate": { "type": "string" },
        "successCount": { "type": "number" },
        "errorCount": { "type": "number" },
        "status": { "type": "string" },
        "errorMsg": { "type": "string" },
        "results": { "type": "array" }
      },
      "required": ["campaignName", "sentDate", "successCount", "errorCount", "status"]
    },
    "Unsubscriber": {
      "title": "Unsubscriber",
      "description": "Unsubscribed customer list",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "unsubscribedAt": { "type": "string" }
      },
      "required": ["email", "unsubscribedAt"]
    }
  },
  "firestore": {
    "products/{id}": {
      "schema": "Product",
      "description": "Products collection"
    },
    "categories/{id}": {
      "schema": "Category",
      "description": "Categories collection"
    },
    "orders/{id}": {
      "schema": "Order",
      "description": "Orders collection"
    },
    "users/{id}": {
      "schema": "User",
      "description": "Users collection"
    },
    "contacts/{id}": {
      "schema": "ContactMessage",
      "description": "Contact messages collection"
    },
    "coupons/{id}": {
      "schema": "Coupon",
      "description": "Discount coupons collection"
    },
    "reviews/{id}": {
      "schema": "Review",
      "description": "Product reviews and ratings collection"
    },
    "subscribers/{id}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers collection"
    },
    "marketing_campaigns/{id}": {
      "schema": "MarketingCampaign",
      "description": "Sent campaigns cache to prevent duplicates"
    },
    "marketing_logs/{id}": {
      "schema": "MarketingLog",
      "description": "Marketing campaign runs log"
    },
    "unsubscribers/{id}": {
      "schema": "Unsubscriber",
      "description": "Unsubscribed email list opt-out"
    }
  }
}
