{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Fióre boutique florist product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "shortDesc": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "stock": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isNew": { "type": "boolean" }
      },
      "required": ["id", "name", "categoryId", "price", "image", "description", "shortDesc", "rating", "reviewsCount", "stock", "isFeatured", "isNew"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "description", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "note": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerEmail", "recipientName", "recipientPhone", "shippingAddress", "totalAmount", "paymentMethod", "paymentStatus", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["id", "email", "name", "phone", "address", "isAdmin"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer contact form message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "replyDetail": { "type": "string" },
        "repliedAt": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "message", "createdAt", "status"]
    }
  },
  "firestore": {
    "products/{id}": {
      "schema": "Product",
      "description": "Products collection"
    },
    "categories/{id}": {
      "schema": "Category",
      "description": "Categories collection"
    },
    "orders/{id}": {
      "schema": "Order",
      "description": "Orders collection"
    },
    "users/{id}": {
      "schema": "User",
      "description": "Users collection"
    },
    "contacts/{id}": {
      "schema": "ContactMessage",
      "description": "Contact messages collection"
    }
  }
}
